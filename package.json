{
  "name": "apps-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.14.1",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "dotenvx run --overload -f .env -- astro dev",
    "build": "dotenvx run --overload -f .env -- astro build",
    "preview": "pnpm run build && dotenvx run --overload -f .env -- astro preview --host",
    "cf:dev": "pnpm run build && dotenvx run --overload -f .env -- wrangler dev",
    "cf:deploy": "dotenvx run --overload -f .env -- wrangler deploy",
    "cf:deploy:dry-run": "dotenvx run --overload -f .env -- wrangler deploy --dry-run",
    "deploy": "pnpm run build && pnpm run cf:deploy",
    "check": "pnpm run build && pnpm run cf:deploy:dry-run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "env:encrypt": "dotenvx encrypt",
    "env:decrypt": "dotenvx decrypt",
    "env:run": "dotenvx run --overload -f .env --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@dotenvx/dotenvx": "^1.75.1",
    "@types/node": "^24.19.2",
    "astro": "^6.4.8",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.154.0"
  }
}
