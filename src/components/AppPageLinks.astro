---
interface LinkItem {
  href?: string;
  label: string;
  note: string;
}

interface Props {
  items: LinkItem[];
  title?: string;
  description?: string;
}

const {
  items,
  title = "ページ一覧",
  description = "各 app は path ごとに分かれているため、support・download・privacy を同じ host 上で育てていけます。",
} = Astro.props;
---

<div class="card">
  <div class="section-heading">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
  <ul class="card-list">
    {items.map((item) => (
      <li>
        <span class="mini-label">{item.label}</span>
        {item.href ? <a class="route-chip" href={item.href}>{item.href}</a> : <span class="route-chip">{item.note}</span>}
        {item.href && <p>{item.note}</p>}
      </li>
    ))}
  </ul>
</div>
